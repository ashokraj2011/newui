      "number": 1,
      "source": {
        "line": 214,
        "path": "singularity/work-items/filter-app/artifacts/specification/spec.md"
      },
      "type": "AC"
    },
    {
      "anchor": "[filter-app:AC-002]",
      "body": "- One or more attributes can be selected, with multiple attributes displayed in the chosen order.\n  *(S1)*",
      "bodySha256": "bf80abb9dba5dfc0dfd43d8cd4a21c75224855b5959cabdab3a7f4fe2dce8a8f",
      "dependsOn": [],
      "id": "FILTER-APP:AC-002",
      "namespace": "FILTER-APP",
      "number": 2,
      "source": {
        "line": 216,
        "path": "singularity/work-items/filter-app/artifacts/specification/spec.md"
      },
      "type": "AC"
    },
    {
      "anchor": "[filter-app:AC-003]",
      "body": "- Top, bottom, and inclusive range modes accept valid values and reject non-positive values or a\n  range whose start is greater than its end. *(S2)*",
      "bodySha256": "8e61267722ee17fe78178980202b41493d5b431b5ba824fee59ae11dd78d2fd0",
      "dependsOn": [],
      "id": "FILTER-APP:AC-003",
      "namespace": "FILTER-APP",
      "number": 3,
      "source": {
        "line": 218,
        "path": "singularity/work-items/filter-app/artifacts/specification/spec.md"
      },
      "type": "AC"
    },
    {
      "anchor": "[filter-app:AC-004]",
      "body": "- A newly added filter starts in top mode with N equal to 10. *(S2)*",
      "bodySha256": "f5f2df5d44e84ae16eee282ba86d522352adf01a088658038ee843d8da86796f",
      "dependsOn": [],
      "id": "FILTER-APP:AC-004",
      "namespace": "FILTER-APP",
      "number": 4,
